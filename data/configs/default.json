{
  "backbone": {
    "BsTimeChanged": {
      "atm_policy": {
        "NearestOrLinearLogMoneyness": {
          "tol_log": 1e-10
        }
      },
      "var_floor": 1e-12,
      "enforce_non_decreasing": true,
      "eta": 0.25
    }
  },
  "grid": {
    "MarketAnchored": {
      "ensure_atm": true,
      "wings": {
        "n_left": 2,
        "n_right": 2,
        "ratio": 1.2
      },
      "atm_refine": {
        "enabled": false,
        "steps": 2,
        "delta_log": 0.05
      },
      "grid_size": {
        "max_points": 80,
        "keep_all_market_strikes": true
      },
      "min_strike": 0.0001,
      "max_strike": 10000.0,
      "min_spacing_log": 0.001
    }
  },
  "fit": {
    "kernel": {
      "omega": "Zero"
    },
    "objective": {
      "L1Mid": {
        "weight": 1.0
      }
    },
    "lp": {
      "enforce_simplex": true,
      "enforce_nonnegativity": true,
      "include_time_constraints": true
    },
    "solver": "Microlp",
    "initialization": {
      "mode": "BackboneSynthetic",
      "price_proxy": "Mid",
      "feasibility_tol": 1e-8
    }
  },
  "time_interp": "AtmVarianceTime",
  "convex_order_validation": "Error"
}
