{
  "backbone": {
    "BsTimeChanged": {
      "atm_policy": {
        "NearestOrLinearLogMoneyness": {
          "tol_log": 1e-10
        }
      },
      "var_floor": 1e-12,
      "enforce_non_decreasing": true,
      "eta": 0.25
    }
  },
  "grid": {
    "MarketAnchored": {
      "ensure_atm": true,
      "wings": {
        "n_left": 2,
        "n_right": 2,
        "ratio": 1.2
      },
      "atm_refine": {
        "enabled": true,
        "steps": 3,
        "delta_log": 0.03
      },
      "grid_size": {
        "max_points": 55,
        "keep_all_market_strikes": false
      },
      "min_strike": 0.0001,
      "max_strike": 10000.0,
      "min_spacing_log": 0.001
    }
  },
  "fit": {
    "kernel": {
      "omega": "Zero"
    },
    "objective": {
      "HingeBidAsk": {
        "slack_penalty": 80.0,
        "epsilon_inside": 0.5
      }
    },
    "lp": {
      "enforce_simplex": true,
      "enforce_nonnegativity": true,
      "include_time_constraints": true
    },
    "solver": "Microlp",
    "initialization": {
      "enabled": true,
      "price_proxy": "Mid",
      "feasibility_tol": 1e-08,
      "projection_tol": 1e-10,
      "near_zero_tol": 1e-10,
      "anchor_l1_weight": 0.02
    }
  },
  "time_interp": "AtmVarianceTime"
}
