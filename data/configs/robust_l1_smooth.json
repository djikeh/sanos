{
  "backbone": {
    "BsTimeChanged": {
      "atm_policy": {
        "NearestOrLinearLogMoneyness": {
          "tol_log": 1e-10
        }
      },
      "var_floor": 1e-12,
      "enforce_non_decreasing": true,
      "eta": 0.25
    }
  },
  "grid": {
    "MarketAnchored": {
      "ensure_atm": true,
      "wings": {
        "n_left": 2,
        "n_right": 2,
        "ratio": 1.2
      },
      "atm_refine": {
        "enabled": true,
        "steps": 3,
        "delta_log": 0.03
      },
      "grid_size": {
        "max_points": 55,
        "keep_all_market_strikes": false
      },
      "min_strike": 0.0001,
      "max_strike": 10000.0,
      "min_spacing_log": 0.001
    }
  },
  "fit": {
    "kernel": {
      "omega": "Zero"
    },
    "constraints": {
      "enforce_simplex": true,
      "enforce_nonnegativity": true,
      "include_time_constraints": true
    },
    "initialization": {
      "mode": "None",
      "price_proxy": "Mid",
      "feasibility_tol": 1e-08
    }
  },
  "time_interp": "AtmVarianceTime"
}
