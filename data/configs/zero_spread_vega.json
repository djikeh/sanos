{
  "backbone": {
    "BsTimeChanged": {
      "atm_policy": {
        "NearestOrLinearLogMoneyness": {
          "tol_log": 1e-10
        }
      },
      "var_floor": 1e-12,
      "enforce_non_decreasing": true,
      "eta": 0.20,
      "effective_var_floor": 5e-4
    }
  },
  "grid": {
    "MarketAnchored": {
      "ensure_atm": true,
      "wings": {
        "n_left": 3,
        "n_right": 3,
        "ratio": 1.3
      },
      "atm_refine": {
        "enabled": true,
        "steps": 3,
        "delta_log": 0.04
      },
      "grid_size": {
        "max_points": 80,
        "keep_all_market_strikes": true
      },
      "min_strike": 0.0001,
      "max_strike": 10000.0,
      "min_spacing_log": 0.001
    }
  },
  "fit": {
    "kernel": {
      "omega": "Zero"
    },
    "weighting": {
      "mode": "Vega",
      "spread_floor": 1e-12,
      "vega_floor": 1e-8
    },
    "regularization": {
      "mode": { "mode": "Smoothing", "order": "D2" },
      "lambda": 0.10,
      "lambda_scaling": {
        "knots": [[0.02, 20.0], [0.1, 2.0], [0.5, 0.5]]
      }
    },
    "constraints": {
      "enforce_simplex": true,
      "enforce_nonnegativity": true,
      "include_time_constraints": true
    },
    "initialization": {
      "mode": "None",
      "price_proxy": "Mid",
      "feasibility_tol": 1e-8,
      "market_completion": {
        "k1_ratio": 0.2,
        "kN_ratio": 2.0,
        "max_iters": 50,
        "slope_margin": 1e-10,
        "hard_caps": null,
        "tol": 1e-10
      }
    }
  },
  "time_interp": "AtmVarianceTime",
  "convex_order_validation": "Error"
}
